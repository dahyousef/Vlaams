{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node -e \"process.exit(require('child_process').spawnSync(process.execPath,[(process.env.CLAUDE_PROJECT_DIR||'.')+'/.claude/hooks/block-dangerous-git.js'],{stdio:'inherit'}).status===0?0:2)\"; exit $LASTEXITCODE" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          { "type": "command", "command": "node -e \"require('child_process').spawnSync(process.execPath,[(process.env.CLAUDE_PROJECT_DIR||'.')+'/.claude/hooks/run-reminder.js'],{stdio:'inherit'})\"; exit $LASTEXITCODE" }
        ]
      }
    ]
  }
}
